{
  "name": "supervolley90",
  "private": true,
  "version": "0.1.0",
  "description": "Arcade 2D volleyball for macOS, inspired by the 90s coin-op classics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/headless.ts",
    "app:dev": "tauri icon src-tauri/icons/icon.png && tauri dev",
    "app:build": "tauri icon src-tauri/icons/icon.png && tauri build",
    "icon": "tsx tools/make-icon.ts src-tauri/icons/icon.png",
    "shots": "tsx tools/screenshot.ts",
    "trace": "tsx tools/trace.ts",
    "e2e:input": "tsx tools/input-e2e.ts",
    "shots:action": "tsx tools/action-shots.ts",
    "poses": "tsx tools/pose-sheet.ts",
    "serve:lab": "tsx tools/serve-lab.ts",
    "anims": "tsx tools/anim-sheet.ts",
    "rig": "tsx tools/rig-sheet.ts",
    "sheets": "tsx tools/make-sheets.ts",
    "frames": "tsx tools/dump-frames.ts",
    "measure:sheet": "tsx tools/measure-sheet.ts",
    "assets:check": "tsx tools/validate-art-assets.ts",
    "check:build": "npm run build && tsx tools/build-check.ts",
    "shots:overhaul": "tsx tools/visual-overhaul-shots.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
