{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Volley 90",
  "version": "0.1.0",
  "identifier": "com.supervolley90.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Super Volley 90",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Arcade 2D volleyball",
    "longDescription": "A 6v6 arcade volleyball game in the spirit of the 90s coin-ops, with a landing-marker aiming system, rotations, blocks and a full five-set match.",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
